{
  "name": "beelab",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev --compatibility-date=2024-09-23 .",
    "deploy": "wrangler pages deploy .",
    "build": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute beelab-db --local --file=migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute beelab-db --remote --file=migrations/0001_initial.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.80.0"
  }
}
